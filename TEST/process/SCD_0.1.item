    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="String filePath =&#xD;&#xA;(String) globalMap.get(&quot;tFileList_1_CURRENT_FILEPATH&quot;);&#xD;&#xA;&#xD;&#xA;String fileName =&#xD;&#xA;new java.io.File(filePath).getName();&#xD;&#xA;&#xD;&#xA;globalMap.put(&quot;LOG_FILE_NAME&quot;, fileName);&#xD;&#xA;&#xD;&#xA;globalMap.put(&quot;LOG_SOURCE_COUNT&quot;, 0);&#xD;&#xA;globalMap.put(&quot;LOG_INSERT_COUNT&quot;, 0);&#xD;&#xA;globalMap.put(&quot;LOG_UPDATE_COUNT&quot;, 0);&#xD;&#xA;globalMap.put(&quot;LOG_REJECT_COUNT&quot;, 0);&#xD;&#xA;&#xD;&#xA;globalMap.put(&#xD;&#xA;&quot;LOG_START_TIME&quot;,&#xD;&#xA;TalendDate.getCurrentDate()&#xD;&#xA;);&#xD;&#xA;&#xD;&#xA;System.out.println(&#xD;&#xA;&quot;====================================&quot;&#xD;&#xA;);&#xD;&#xA;&#xD;&#xA;System.out.println(&#xD;&#xA;&quot;Processing file: &quot; + fileName&#xD;&#xA;);&#xD;&#xA;&#xD;&#xA;System.out.println(&#xD;&#xA;&quot;Counts reset for new file&quot;&#xD;&#xA;);"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
